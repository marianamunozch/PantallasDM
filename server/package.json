{
  "name": "pantallasdm-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API REST de reservas de barberia - Node + Express + PostgreSQL",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "db:setup": "tsx scripts/setup-db.ts",
    "db:setup:test": "tsx scripts/setup-db.ts --test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
