# Copiar a .env y ajustar. NUNCA versionar el .env real.
NODE_ENV=development
PORT=3000

# Puerto en el que Docker publica PostgreSQL.
# Si lo cambias, cambia TAMBIEN el puerto dentro de DATABASE_URL.
DB_PORT=5434

# Debe coincidir con docker-compose.yml
DATABASE_URL=postgresql://pantallasdm:pantallasdm_dev@localhost:5434/pantallasdm
DATABASE_URL_TEST=postgresql://pantallasdm:pantallasdm_dev@localhost:5434/pantallasdm_test

# Origenes permitidos por CORS, separados por coma. Vacio = ninguno.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
